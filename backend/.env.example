# Copiez ce fichier en .env (jamais commite) et completez les valeurs.

# Requis - home-auth (service SSO central), client OAuth2 confidentiel
# enregistre via /admin/clients sur home-auth
AUTH_SERVICE_URL=https://auth.sloboda.fr
AUTH_CLIENT_ID=home-remote-mcps
AUTH_CLIENT_SECRET=change-me

# Requis - secret partage avec home-auth pour le webhook de revocation
# (POST /auth/disconnect?secret=..., configure comme logoutWebhookUrl du client)
AUTH_WEBHOOK_SECRET=change-me

# Requis - URL publique de ce service (redirect_uri OAuth2, CORS, URL des liens MCP renvoyes a Claude)
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Requis - cle maitre pour chiffrer les tokens de session (Garmin, etc.) stockes en base.
# >= 32 caracteres aleatoires. Perdre cette cle = perdre l'acces a tous les credentials stockes.
CREDENTIALS_ENCRYPTION_KEY=change-me-32-chars-minimum-please

# Requis - garmin-connector (sidecar Python interne, jamais expose publiquement)
GARMIN_CONNECTOR_URL=http://garmin-connector:8000
GARMIN_CONNECTOR_SECRET=change-me

# Requis - cookidoo-connector (sidecar Python interne, jamais expose publiquement)
COOKIDOO_CONNECTOR_URL=http://cookidoo-connector:8000
COOKIDOO_CONNECTOR_SECRET=change-me

# Optionnel - base URL du service personal-health (health.sloboda.fr).
# Par defaut https://health.sloboda.fr si non defini.
PERSONAL_HEALTH_API_URL=

# Optionnel - chemin du fichier SQLite
DATABASE_PATH=

# Optionnel
NODE_ENV=development
PORT=3000

# Optionnel - replication Litestream de la DB SQLite vers MinIO (S3-compatible),
# meme bucket que les autres apps home-*. Si MINIO_BUCKET est defini, le
# conteneur restaure la DB au demarrage et la replique en continu.
# Ces memes variables alimentent aussi le connecteur MCP "logs" (lecture des
# logs Docker deposes par Vector, voir le repo home-monitoring) - pas de
# secret supplementaire, seul le prefixe (base path) est configure par
# utilisateur via l'UI.
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REPLICA_PATH=remote-mcps-db
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
